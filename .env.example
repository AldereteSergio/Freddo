# Zayka - Configuración de Entorno

# URL de la instancia de SearXNG (Requerido para búsquedas web)
SEARXNG_API_URL=http://localhost:4000

# Tamaño de contexto para Ollama (Opcional, por defecto 32000)
# Ajustar según la RAM/VRAM disponible en tu hardware.
OLLAMA_NUM_CTX=32000

# Habilitar Reranker Local (Opcional, por defecto false)
# ADVERTENCIA: Requiere recursos significativos de GPU/RAM. 
# No activar en notebooks con video integrado de baja capacidad (ej. 1GB).
ENABLE_LOCAL_RERANKER=false

# Directorio de datos persistentes (Opcional)
# DATA_DIR=./data

# Secreto para SearXNG (Generar uno fuerte para producción)
# Puedes usar: openssl rand -hex 32
SEARXNG_SECRET=306e987c89fca6e828469de2a3a5e8f470d06a86e92bca1e9cb1906f30d065df
